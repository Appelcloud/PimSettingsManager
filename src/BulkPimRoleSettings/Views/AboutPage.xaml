<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BulkPimRoleSettings.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Click="BackButton_Click" ToolTipService.ToolTip="Back" Padding="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <TextBlock Grid.Column="1" Text="About" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="560" HorizontalAlignment="Center" Spacing="20" Padding="32,40,32,40">

                <!-- Profile Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="32,28" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">

                        <!-- Avatar and badge row -->
                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                            <Grid Width="128" Height="128">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,128,128"/>
                                </Grid.Clip>
                                <Border CornerRadius="64">
                                    <Image Width="128" Height="128" Stretch="UniformToFill"
                                           Source="ms-appx:///Assets/portrait.png"/>
                                </Border>
                            </Grid>
                            <Image Width="96" Height="96" VerticalAlignment="Center" Stretch="Uniform"
                                   Source="ms-appx:///Assets/mvp-logo.png"/>
                        </StackPanel>

                        <!-- Name and title -->
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Alexander Appelby" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Microsoft 365 &amp; Security MVP" FontSize="13"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Bio -->
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            I'm a Microsoft 365 &amp; Security MVP with 10+ years in the Microsoft ecosystem. I care deeply about the community and spend a lot of my time building free tools and writing about the things I work with every day such as Microsoft 365, Identity &amp; Access Management, Security, and Cloud solutions.
                        </TextBlock>

                    </StackPanel>
                </Border>

                <!-- Links Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="24,20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Links" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <HyperlinkButton NavigateUri="https://blog.appelcloud.dk" HorizontalAlignment="Stretch" Padding="8,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE774;" FontSize="16"/>
                                <TextBlock Text="Blog – appelcloud.dk" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HyperlinkButton>

                        <HyperlinkButton NavigateUri="https://tools.appelcloud.dk" HorizontalAlignment="Stretch" Padding="8,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE90F;" FontSize="16"/>
                                <TextBlock Text="Tools Hub – tools.appelcloud.dk" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HyperlinkButton>

                        <HyperlinkButton NavigateUri="https://mvp.microsoft.com/en-US/mvp/profile/12ef06cd-cdab-4545-b87d-b7b682dd0d67" HorizontalAlignment="Stretch" Padding="8,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE734;" FontSize="16"/>
                                <TextBlock Text="MVP Profile" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HyperlinkButton>

                        <HyperlinkButton NavigateUri="https://dk.linkedin.com/in/alexander-appelby" HorizontalAlignment="Stretch" Padding="8,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE910;" FontSize="16"/>
                                <TextBlock Text="LinkedIn" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </Border>

                <!-- Support Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="24,20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="Support my work" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        <HyperlinkButton NavigateUri="https://www.buymeacoffee.com/appelcloud"
                                         HorizontalAlignment="Center" Padding="16,10"
                                         Background="#FFDD00" CornerRadius="6">
                            <TextBlock Text="🍺 Buy me a beer" Foreground="Black" FontWeight="SemiBold" FontSize="14"/>
                        </HyperlinkButton>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
